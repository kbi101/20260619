@prefix : <http://quant.example.org/ontology/strategy#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://quant.example.org/ontology/strategy> a owl:Ontology ;
    rdfs:label "QuantTune Strategy Domain Ontology" ;
    rdfs:comment "Base OWL/RDFS definitions aligned with FIBO, OWL-Time, and QUDT." .

:Bar1Week a :WeeklyInterval ;
    rdfs:label "1-Week Bar Interval" .

:EquityStock rdfs:label "Individual Equity Stock" ;
    rdfs:subClassOf :FinancialInstrument .

:MeanReversionIWM_15m a :Strategy ;
    rdfs:label "IWM 15-Min Mean Reversion Strategy" ;
    :activeInRegime :HighVolatilityRegime ;
    :operatesOnTimeframe :Bar15Min ;
    :tradesInstrument :IWM .

:MeanReversionQQQ_15m a :Strategy ;
    rdfs:label "QQQ 15-Min Mean Reversion Strategy" ;
    :activeInRegime :HighVolatilityRegime ;
    :operatesOnTimeframe :Bar15Min ;
    :tradesInstrument :QQQ .

