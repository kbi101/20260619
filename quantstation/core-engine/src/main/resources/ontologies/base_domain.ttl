:MomentumQQQ_1D a :Strategy ;
    rdfs:label "QQQ Daily Momentum Strategy" ;
    :activeInRegime :TrendingRegime ;
    :operatesOnTimeframe :Bar1Day ;
    :tradesInstrument :QQQ .

:activeInRegime a owl:ObjectProperty ;
    rdfs:label "Strategy is active in this market regime" ;
    rdfs:domain :Strategy ;
    rdfs:range :MarketRegime .

:hasTargetPolicy a owl:ObjectProperty ;
    rdfs:label "Strategy's assigned target policy (injected by SHACL)" ;
    rdfs:domain :Strategy ;
    rdfs:range :TargetPolicy .

:operatesOnTimeframe a owl:ObjectProperty ;
    rdfs:label "Strategy operates on this timeframe" ;
    rdfs:domain :Strategy ;
    rdfs:range :TimeInterval .

:stopLossZScore a owl:DatatypeProperty ;
    rdfs:label "Stop-loss Z-score boundary" ;
    rdfs:domain :TargetPolicy ;
    rdfs:range xsd:decimal .

:takeProfitZScore a owl:DatatypeProperty ;
    rdfs:label "Take-profit Z-score boundary" ;
    rdfs:domain :TargetPolicy ;
    rdfs:range xsd:decimal .

:targetType a owl:DatatypeProperty ;
    rdfs:label "Target classification type identifier" ;
    rdfs:domain :TargetPolicy ;
    rdfs:range xsd:string .

:timeStopMinutes a owl:DatatypeProperty ;
    rdfs:label "Time-stop in minutes (max holding period)" ;
    rdfs:domain :TargetPolicy ;
    rdfs:range xsd:integer .

:maxRsiThreshold a owl:DatatypeProperty ;
    rdfs:label "Maximum RSI value allowed for Long entry" ;
    rdfs:domain :TargetPolicy ;
    rdfs:range xsd:decimal .

:maxAdxThreshold a owl:DatatypeProperty ;
    rdfs:label "Maximum ADX value allowed for Mean-Reversion entry" ;
    rdfs:domain :TargetPolicy ;
    rdfs:range xsd:decimal .

:requireMacdBullish a owl:DatatypeProperty ;
    rdfs:label "Requires MACD histogram to be positive (> 0)" ;
    rdfs:domain :TargetPolicy ;
    rdfs:range xsd:boolean .

:useHmmFilter a owl:DatatypeProperty ;
    rdfs:label "Requires Gaussian HMM low-volatility regime state (S=0)" ;
    rdfs:domain :TargetPolicy ;
    rdfs:range xsd:boolean .

:tradesInstrument a owl:ObjectProperty ;
    rdfs:label "Strategy trades this instrument" ;
    rdfs:domain :Strategy ;
    rdfs:range :FinancialInstrument .

:DailyInterval rdfs:label "Daily Bar Interval" ;
    rdfs:subClassOf :TimeInterval .

:IWM a :EquityETF ;
    rdfs:label "iShares Russell 2000 ETF" .

:IntradayInterval rdfs:label "Intraday Bar Interval" ;
    rdfs:subClassOf :TimeInterval .

:MeanReversionRegime a :MarketRegime ;
    rdfs:label "Mean-Reversion / Choppy Regime (ADX < 20)" .

:TrendingRegime a :MarketRegime ;
    rdfs:label "Trending Market Regime (ADX > 25)" .

:WeeklyInterval rdfs:label "Weekly Bar Interval" ;
    rdfs:subClassOf :TimeInterval .

:XLB a :EquityETF ;
    rdfs:label "Materials Select Sector SPDR Fund" ;
    :tickerSymbol "XLB"^^xsd:string .

:XLC a :EquityETF ;
    rdfs:label "Communication Services Select Sector SPDR Fund" ;
    :tickerSymbol "XLC"^^xsd:string .

:XLE a :EquityETF ;
    rdfs:label "Energy Select Sector SPDR Fund" ;
    :tickerSymbol "XLE"^^xsd:string .

:XLF a :EquityETF ;
    rdfs:label "Financial Select Sector SPDR Fund" ;
    :tickerSymbol "XLF"^^xsd:string .

:XLI a :EquityETF ;
    rdfs:label "Industrial Select Sector SPDR Fund" ;
    :tickerSymbol "XLI"^^xsd:string .

:XLK a :EquityETF ;
    rdfs:label "Technology Select Sector SPDR Fund" ;
    :tickerSymbol "XLK"^^xsd:string .

:XLP a :EquityETF ;
    rdfs:label "Consumer Staples Select Sector SPDR Fund" ;
    :tickerSymbol "XLP"^^xsd:string .

:XLRE a :EquityETF ;
    rdfs:label "Real Estate Select Sector SPDR Fund" ;
    :tickerSymbol "XLRE"^^xsd:string .

:XLU a :EquityETF ;
    rdfs:label "Utilities Select Sector SPDR Fund" ;
    :tickerSymbol "XLU"^^xsd:string .

:XLV a :EquityETF ;
    rdfs:label "Health Care Select Sector SPDR Fund" ;
    :tickerSymbol "XLV"^^xsd:string .

:XLY a :EquityETF ;
    rdfs:label "Consumer Discretionary Select Sector SPDR Fund" ;
    :tickerSymbol "XLY"^^xsd:string .

:Bar1Day a :DailyInterval ;
    rdfs:label "1-Day Bar Interval" .

:QQQ a :EquityETF ;
    rdfs:label "Invesco QQQ Trust (Nasdaq-100 ETF)" .

:SPY a :EquityETF ;
    rdfs:label "SPDR S&P 500 ETF Trust" .

:FinancialInstrument a owl:Class ;
    rdfs:label "Base Financial Instrument (FIBO aligned)" .

:MarketRegime a owl:Class ;
    rdfs:label "Market Regime Classification" .

:TimeInterval a owl:Class ;
    rdfs:label "Time Interval (OWL-Time aligned)" .

:TargetPolicy a owl:Class ;
    rdfs:label "Execution Target Policy" .

:Bar15Min a :IntradayInterval ;
    rdfs:label "15-Minute Bar Interval" .

:Bar5Min a :IntradayInterval ;
    rdfs:label "5-Minute Bar Interval" .

