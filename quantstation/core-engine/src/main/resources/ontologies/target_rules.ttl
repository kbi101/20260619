# ─── SHACL Classification Rules (Per-Symbol Multi-Condition Shapes) ────

# ── Symbol Rule: SPY Multi-Condition 15-Min ────────────────────────
:StrategyClassificationShape_SPY15m a sh:NodeShape ;
    sh:targetClass :Strategy ;
    sh:rule [
        a sh:TripleRule ;
        sh:condition [
            sh:property [ sh:path :tradesInstrument ;    sh:hasValue :SPY ] ;
            sh:property [ sh:path :operatesOnTimeframe ; sh:hasValue :Bar15Min ] ;
            sh:property [ sh:path :activeInRegime ;      sh:hasValue :HighVolatilityRegime ] ;
        ] ;
        sh:subject   sh:this ;
        sh:predicate :hasTargetPolicy ;
        sh:object    :DynamicGexPinning_SPY_15m
    ] .

