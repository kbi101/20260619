:DynamicGexPinning_SPY_5m a :TargetPolicy ;
    :targetType       "MULTI_CONDITION_GEX_5M" ;
    :stopLossZScore   0.7 ;
    :takeProfitZScore 2.6 ;
    :timeStopMinutes  5 ;
    :maxRsiThreshold   30.0 .

:DynamicGexPinning_QQQ_5m a :TargetPolicy ;
    :targetType       "MULTI_CONDITION_GEX_5M" ;
