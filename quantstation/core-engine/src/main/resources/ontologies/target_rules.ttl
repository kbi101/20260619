# ─── Target Policy Individuals (Multi-Condition Tuned) ─────────────────

:DailyMeanReversionPolicy a :TargetPolicy ;
    :targetType       "DAILY_MEAN_REVERSION" ;
    :stopLossZScore   1.5 ;
    :takeProfitZScore 2.5 ;
    :timeStopMinutes  1440 .

:DailyMomentumBreakoutPolicy a :TargetPolicy ;
    :targetType       "DAILY_MOMENTUM_BREAKOUT" ;
    :stopLossZScore   1.0 ;
    :takeProfitZScore 3.0 ;
    :timeStopMinutes  2880 .

:DynamicGexPinningPolicy_15m a :TargetPolicy ;
    :targetType       "DYNAMIC_GEX_PINNING" ;
    :stopLossZScore   1.0 ;
    :takeProfitZScore 1.5 ;
    :timeStopMinutes  45 .

:DynamicGexPinning_SPY_15m a :TargetPolicy ;
    :targetType       "MULTI_CONDITION_GEX" ;
    :stopLossZScore   0.8 ;
    :takeProfitZScore 1.1 ;
    :timeStopMinutes  15 ;
    :maxRsiThreshold   32.5 ;
    :useHmmFilter      true .

